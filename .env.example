# Client-side (VITE_* vars are inlined into the browser bundle — never put secrets here)
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=69ac08e1000402826be5
VITE_APPWRITE_DATABASE_ID=quran_db
VITE_APPWRITE_USER_DATA_COLLECTION_ID=user_sync

# ── Render.com backend (opt-in; default OFF = Appwrite stays in use) ─────────
# Set VITE_USE_RENDER_API=true to move auth/sync/realtime to the Render API and
# remap the frozen /v1 content endpoints to VITE_API_BASE_URL. Unset/false keeps
# the app on Appwrite + api.quran.com exactly as before.
# VITE_USE_RENDER_API=false
# VITE_API_BASE_URL=https://quran-nur-api.onrender.com

# Server-side only (Do not prefix with VITE_)
APPWRITE_API_KEY=your_appwrite_api_key_here
