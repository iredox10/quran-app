# Appwrite Configuration (optional - for cloud sync)
# Leave empty to run in local-only mode (all data stored on device)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id
VITE_APPWRITE_USER_DATA_COLLECTION_ID=your_appwrite_user_data_collection_id

# For setup script (server-side, not exposed to browser)
# API_KEY=your_appwrite_api_key
