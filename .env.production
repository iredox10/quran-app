# Build-time client config for `vite build` (mode=production).
# VITE_* values are inlined into the browser bundle — NEVER put secrets here.
# Real process env vars override these; keep CI/host build settings in sync.
VITE_APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="69ac08e1000402826be5"
VITE_APPWRITE_PROJECT_NAME="quran-app"
VITE_APPWRITE_DATABASE_ID="quran_db"
VITE_APPWRITE_USER_DATA_COLLECTION_ID="user_sync"
